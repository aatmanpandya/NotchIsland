{
  "manifest_version": 3,
  "name": "NotchIsland Bridge",
  "version": "0.1.0",
  "description": "Shows what's playing in your browser on the NotchIsland notch app for Mac.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
